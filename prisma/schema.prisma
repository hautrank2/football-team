// Prisma schema — Football team social + fantasy app
// Datasource: MongoDB. Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  PLAYER
  ADMIN
}

enum LineupSize {
  FIVE
  SEVEN
  ELEVEN
}

enum MaritalStatus {
  SINGLE
  IN_RELATIONSHIP
  MARRIED
  COMPLICATED
  CASUAL // Mối quan hệ không ràng buộc
  AMBIGUOUS // Mập mờ
}

// Gender — biological sex + orientation options combined into one field.
// Stored as code; the FE labels it.
enum Gender {
  MALE // Nam
  FEMALE // Nữ
  INTERSEX // Liên giới tính
  HETEROSEXUAL // Dị tính
  HOMOSEXUAL // Đồng tính
  BISEXUAL // Song tính
  PANSEXUAL // Toàn tính
  ASEXUAL // Vô tính
  QUESTIONING // Đang tìm hiểu
  OTHER // Khác
  UNSPECIFIED // Không xác định
}

// Playing position. Stored as code; FE labels it. Coarse + specific roles.
enum PlayerPosition {
  GOALKEEPER // Thủ môn
  SWEEPER // Trung vệ thòng (libero)
  CENTER_BACK // Trung vệ
  DEFENDER // Hậu vệ
  WING_BACK // Hậu vệ cánh
  DEF_MID // Tiền vệ phòng ngự
  CENTER_MID // Tiền vệ trung tâm
  MIDFIELDER // Tiền vệ
  ATT_MID // Tiền vệ tấn công (hộ công)
  WINGER // Tiền đạo cánh
  SECOND_STRIKER // Tiền đạo hộ công
  STRIKER // Trung phong
  FORWARD // Tiền đạo
}

// Social platform for a player's social link.
enum SocialType {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  OTHER
}

// Lifecycle of a confirmed match. Time-based gates (vote lock, report window)
// are derived from the clock via src/constants/schedule.ts — NOT from status.
enum MatchStatus {
  SCHEDULED // đã chốt ngày, chờ đá
  FINISHED // đã đá xong
  CANCELLED // huỷ trận
}

// Headline title / danh xưng. Stored as code; the FE decides the label.
enum PlayerTitle {
  // Serious
  FORWARD
  MIDFIELDER
  DEFENDER
  GOALKEEPER
  WINGER
  BOX_TO_BOX
  // Fun
  MAESTRO
  SNIPER
  THE_WALL
  AERIAL_KING
  SPEEDSTER
  ENGINE
  CARRY
  FREE_KICK_MASTER
  BUTCHER
  GIANT
  LUKAKU_SHOOTER
  NEYMAR_DIVER
  REFLEX_KING
  BENCH_KING
  SHIN_DESTROYER
  ALL_TALK
  GLASS_MAN
  OFFSIDE_KING
  WOODEN_LEG
  INVISIBLE_MAN
  SECOND_REFEREE
  LAST_MINUTE_HERO
  BACKPASS_SAINT
  NO_LUNGS
  TACKLE_KING
  COLD_BLOODED
  ENTERTAINER
  PITCH_TERROR
  GOAL_POACHER
  XE_OM
  MESSI_PHOTOCOPY
  CAPTAIN_FOREVER
}

// ---------------------------------------------------------------------------
// Embedded composite types
// ---------------------------------------------------------------------------

// One player placed on the pitch inside a Lineup. Position is derived purely
// from x/y (0-100) + the lineup's formation — no position label is stored.
type LineupSlot {
  playerId  String  @db.ObjectId
  x         Int
  y         Int
  isCaptain Boolean @default(false)
}

// A player's social link (Facebook, Instagram, ...). Embedded on Player.
type PlayerSocial {
  type SocialType
  link String
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Team {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  shortName   String?
  description String?

  players Player[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A player is also the login account.
model Player {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  // Auth
  username      String         @unique
  passwordHash  String
  role          Role           @default(PLAYER)
  // Soft delete — players are never hard-deleted (keeps lineups/quotes intact).
  // Optional so pre-existing documents (without the field) read back fine.
  isDeleted     Boolean?       @default(false)
  // Test-only accounts — hidden from the player directory GET (list + detail),
  // but otherwise normal players (can vote / join matches).
  isTest        Boolean?       @default(false)
  // Profile
  fullName      String
  nickname      String?
  avatarUrl     String?
  avatarNoBg    String?
  bio           String?
  birthday      DateTime
  gender        Gender         @default(MALE)
  maritalStatus MaritalStatus?
  phone         String? // 10–11 digits (validated at the API layer)
  // Location — address is Mapbox reverse-geocoded then freely editable;
  // coordinate is [longitude, latitude], set ONLY from a Mapbox pick.
  address       String?
  coordinate    Float[]        @default([])
  socials       PlayerSocial[]
  achievements  String[]
  // Physical
  jerseyNumber  Int? // 1-99 (validated at the API layer)
  foot          Int[] // [left, right], each 1-5
  height        Int? // cm
  weight        Int? // kg
  // Football
  title         PlayerTitle
  teamId        String?          @db.ObjectId
  team          Team?            @relation(fields: [teamId], references: [id])
  positions     PlayerPosition[] @default([])
  // Reliability — điểm uy tín. Giảm 1 khi player unvote SAU khi trận đã tạo.
  // Optional so pre-existing Player docs (without the field) read back fine.
  // Nghiệp vụ dùng điểm này (chặn vote, xếp hạng...) sẽ làm sau.
  reputation    Int?             @default(100)

  // Relations
  attribute      PlayerAttribute?
  quotesWritten  PlayerQuote[]    @relation("QuoteAuthor")
  quotesReceived PlayerQuote[]    @relation("QuoteSubject")
  lineups        Lineup[]
  comments       LineupComment[]

  // Schedule / Match
  matchVotes       MatchVote[]
  matchPlayers     MatchPlayer[]
  mvpVotesCast     MatchMvpVote[] @relation("MvpVoter")
  mvpVotesReceived MatchMvpVote[] @relation("MvpTarget")
  matchesAsMvp     Match[]        @relation("MatchMvp", fields: [matchesAsMvpIds], references: [id])
  matchesAsMvpIds  String[]       @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Game-like skill ratings (FIFA-style). 1-1 with Player. All values 0-99.
model PlayerAttribute {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  playerId String @unique @db.ObjectId
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  overall    Int
  skillMoves Int // 1-5

  // Pace
  acceleration   Int
  sprintSpeed    Int
  // Shooting
  attPositioning Int
  finishing      Int
  shotPower      Int
  longShots      Int
  volleys        Int
  penalties      Int
  // Passing
  vision         Int
  crossing       Int
  freeKick       Int
  shortPassing   Int
  longPassing    Int
  curve          Int
  // Dribbling
  agility        Int
  balance        Int
  reactions      Int
  ballControl    Int
  dribbling      Int
  composure      Int
  // Defending
  interceptions  Int
  heading        Int
  defAwareness   Int
  standingTackle Int
  slidingTackle  Int
  // Physical
  jumping        Int
  stamina        Int
  strength       Int
  aggression     Int
  // Goalkeeping (optional — only for keepers)
  gkDiving       Int?
  gkHandling     Int?
  gkKicking      Int?
  gkReflexes     Int?
  gkPositioning  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A short quote one player writes about another (or about themselves).
// One quote per (author, subject).
model PlayerQuote {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  subjectId String @db.ObjectId
  subject   Player @relation("QuoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  authorId  String @db.ObjectId
  author    Player @relation("QuoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String

  createdAt DateTime @default(now())

  @@unique([authorId, subjectId])
}

// A user-built fantasy squad. Slots are embedded (no separate collection).
model Lineup {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  ownerId   String       @db.ObjectId
  owner     Player       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  size      LineupSize
  formation String
  note      String?
  isPublic  Boolean      @default(true)
  slots     LineupSlot[]

  comments LineupComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Comments on a lineup, with one level of threading via parentId.
model LineupComment {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  lineupId String  @db.ObjectId
  lineup   Lineup  @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  authorId String  @db.ObjectId
  author   Player  @relation(fields: [authorId], references: [id])
  parentId String? @db.ObjectId
  content  String

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Schedule / Match
// ---------------------------------------------------------------------------

// A player's intent to play on a given day (self + guests). The single source of
// "intent"; once a day is confirmed as a Match, votes are mirrored into
// MatchPlayer. Votable window + lock are enforced in src/constants/schedule.ts.
model MatchVote {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  playerId String @db.ObjectId
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Ngày muốn chơi — chuẩn hoá về đầu ngày (00:00 giờ VN) để so ngày & unique.
  voteDate DateTime

  // Số khách player dẫn theo (dùng để chia tiền — player tự chịu tiền khách).
  guestCount Int     @default(0)
  note       String?

  // Set khi ngày này được admin chốt thành trận. matchId != null ⇒ unvote bị
  // trừ điểm uy tín.
  matchId String? @db.ObjectId
  match   Match?  @relation(fields: [matchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, voteDate])
  @@index([voteDate])
  @@index([matchId])
}

// A confirmed match, created by the admin from the votes on a chosen day.
model Match {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  matchDate DateTime // đầu ngày thi đấu
  kickoffAt DateTime // giờ bóng lăn — mặc định 19:00 của matchDate
  location  String?
  status    MatchStatus @default(SCHEDULED)
  note      String?

  // Tiền sân — admin nhập bất kỳ lúc nào sau trận (không giới hạn). null = chưa.
  // totalHeads/costPerHead chốt cứng lúc nhập tiền để hoá đơn bất biến.
  fieldCost   Int? // tổng tiền sân (VND)
  totalHeads  Int? // Σ(1 + guestCount) tại thời điểm chốt tiền
  costPerHead Int? // ceil(fieldCost / totalHeads) — làm tròn LÊN

  // MVP — chốt tự động sau report window: nhóm nhiều phiếu nhất (hoà lấy hết,
  // phải > 0). Quan hệ n-n với Player.
  mvpPlayers   Player[] @relation("MatchMvp", fields: [mvpPlayerIds], references: [id])
  mvpPlayerIds String[] @db.ObjectId

  players  MatchPlayer[]
  mvpVotes MatchMvpVote[]
  votes    MatchVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchDate]) // một ngày tối đa một trận
  @@index([status])
}

// One player on a match's participant list ("danh sách tham gia") — a mirror of
// the votes. Carries the money split, self-reported goals/assists, payment state.
model MatchPlayer {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  matchId  String @db.ObjectId
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String @db.ObjectId
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  guestCount Int @default(0) // snapshot từ MatchVote

  // Số bàn thắng / kiến tạo player tự nhập sau trận (chỉ trong report window,
  // mỗi trận tối đa 100 — validate ở API).
  goals   Int @default(0)
  assists Int @default(0)

  // Chia tiền: amountDue = costPerHead * (1 + guestCount). VND. isPaid do admin.
  amountDue Int     @default(0)
  isPaid    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId])
  @@index([playerId])
}

// One MVP ballot: a participant votes one player as MVP of a match. Allowed only
// during the report window; tally decides Match.mvpPlayerIds.
model MatchMvpVote {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  matchId     String @db.ObjectId
  match       Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  voterId     String @db.ObjectId
  voter       Player @relation("MvpVoter", fields: [voterId], references: [id], onDelete: Cascade)
  mvpPlayerId String @db.ObjectId
  mvpPlayer   Player @relation("MvpTarget", fields: [mvpPlayerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([matchId, voterId])
  @@index([matchId, mvpPlayerId])
}
